    SessionLogic --> Logger[Session Logger]

    StateBuilder --> KB
    Policy --> Model[Trained Model]
    CommandBuilder --> ActionCatalog[Action Catalog]
    CommandBuilder --> CommandProfiles[Command Profiles]

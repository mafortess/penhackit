@startuml cap2-fases-pentest

title Fases principales de una prueba de penetración

left to right direction

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam linetype polyline
skinparam rectangle {
    BorderColor Black
    BackgroundColor White
    RoundCorner 12
}

rectangle "1. Planificación\ny alcance\n\n- Objetivos\n- Límites\n- Reglas\n- Criterios de éxito" as PLAN

rectangle "2. Reconocimiento\n\n- Información inicial\n- Rangos de red\n- Dominios\n- Superficie expuesta" as RECON

rectangle "3. Enumeración\n\n- Hosts activos\n- Puertos abiertos\n- Servicios\n- Versiones" as ENUM

rectangle "4. Análisis de\nvulnerabilidades\n\n- Debilidades candidatas\n- CVE\n- Configuraciones\n- Hipótesis" as VULN

rectangle "5. Explotación\n\n- Validación técnica\n- Prueba de impacto\n- Acceso o evidencia\n- Confirmación del riesgo" as EXPLOIT

rectangle "6. Post-explotación\n\n- Alcance obtenido\n- Privilegios\n- Evidencias\n- Impacto potencial" as POST

rectangle "7. Reporte\n\n- Hallazgos\n- Evidencias\n- Riesgos\n- Recomendaciones" as REPORT

PLAN --> RECON : define objetivo
RECON --> ENUM : descubre activos
ENUM --> VULN : identifica superficie
VULN --> EXPLOIT : valida hipótesis
EXPLOIT --> POST : analiza impacto
POST --> REPORT : documenta resultados

ENUM --> RECON : nueva información
VULN --> ENUM : ampliar enumeración
EXPLOIT --> VULN : hipótesis fallida
POST --> RECON : nuevos activos

@enduml

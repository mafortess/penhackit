```puml
@startuml cap5-casos-uso-sesiones

title Casos de uso: sesiones, modos de operación y configuración

top to bottom direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 30
skinparam ArrowFontSize 8
skinparam usecase {
    BackgroundColor White
    BorderColor Black
    FontSize 10
}
skinparam rectangle {
    BorderColor Black
}

actor "Pentester /\nusuario técnico" as User

rectangle "PenHackIt" {

    package "Interacción principal" as P_Main {
        usecase "Gestionar\nsesiones" as UC_ManageSessions
        usecase "Ejecutar\nsesión" as UC_RunSession
        usecase "Configurar\nsistema" as UC_ManageConfig

        UC_ManageSessions -[hidden]right- UC_RunSession
        UC_RunSession -[hidden]right- UC_ManageConfig
    }

    package "Gestión de sesiones" as P_Sessions {
        usecase "Crear y configurar\nsesión" as UC_CreateSession
        usecase "Consultar\nsesiones" as UC_ListSessions
        usecase "Ver detalle\nde sesión" as UC_ViewSession
        usecase "Eliminar\nsesión" as UC_DeleteSession

        UC_CreateSession -[hidden]right- UC_ListSessions
        UC_ListSessions -[hidden]right- UC_ViewSession
        UC_ViewSession -[hidden]right- UC_DeleteSession
    }

    package "Configuración" as P_Config {
        usecase "Consultar\nconfiguración" as UC_ShowConfig
        usecase "Actualizar\nconfiguración" as UC_UpdateConfig
        usecase "Restaurar valores\npor defecto" as UC_ResetConfig

        UC_ShowConfig -[hidden]right- UC_UpdateConfig
        UC_UpdateConfig -[hidden]right- UC_ResetConfig
    }

    package "Modos de operación" as P_Modes {
        usecase "Modo\nobservación" as UC_Observation
        usecase "Modo\nsugerencia" as UC_Suggestion
        usecase "Modo\nautónomo" as UC_Autonomous

        UC_Observation -[hidden]right- UC_Suggestion
        UC_Suggestion -[hidden]right- UC_Autonomous
    }

    package "Procesamiento de sesión" as P_Process {
        usecase "Registrar acciones,\ncomandos y resultados" as UC_Register
        usecase "Procesar resultados\ny eventos" as UC_Process
        usecase "Actualizar información\nde sesión" as UC_Update

        UC_Register -[hidden]right- UC_Process
        UC_Process -[hidden]right- UC_Update
    }

    P_Main -[hidden]down- P_Sessions
    P_Sessions -[hidden]down- P_Config
    P_Config -[hidden]down- P_Modes
    P_Modes -[hidden]down- P_Process
}

actor "Herramientas externas\n(nmap, msfconsole,\nftp, comandos SO)" as Tools

User -down-> UC_ManageSessions
User -down-> UC_RunSession
User -down-> UC_ManageConfig

UC_ManageSessions .down.> UC_CreateSession : <<include>>
UC_ManageSessions .down.> UC_ListSessions : <<include>>
UC_ManageSessions .down.> UC_ViewSession : <<include>>
UC_ManageSessions .down.> UC_DeleteSession : <<include>>

UC_ManageConfig .down.> UC_ShowConfig : <<include>>
UC_ManageConfig .down.> UC_UpdateConfig : <<include>>
UC_ManageConfig .down.> UC_ResetConfig : <<include>>

UC_RunSession .down.> UC_Observation : <<extend>>
UC_RunSession .down.> UC_Suggestion : <<extend>>
UC_RunSession .down.> UC_Autonomous : <<extend>>

UC_RunSession .down.> UC_Register : <<include>>
UC_RunSession .down.> UC_Process : <<include>>
UC_RunSession .down.> UC_Update : <<include>>

UC_Observation -down-> Tools
UC_Suggestion -down-> Tools
UC_Autonomous -down-> Tools

@enduml
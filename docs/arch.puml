@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

title Arquitectura software de PenHackIt

package "src/penhackit" {

  package "app" {
    [startup.py]
  }

  package "cli" {
    [main.py]
    package "menus" {
      [main_menu.py]
      [session_menu.py]
      [training_menu.py]
      [report_menu.py]
      [settings_menu.py]
    }
  }

  package "common" {
    [paths.py]
    [environment.py]
  }

  package "session" {

    [session_wizard.py]
    [session_services.py]
    [session_runner.py]
    [session_storage.py]
    [session_config.py]
    [session_views.py]

    package "action" {
      [action_catalog.py]
      [action_ids.py]
      [command_mapping.py]
      [recon.py]
      [enumeration.py]
      [vulnerability.py]
      [exploitation.py]
      [post_exploitation.py]
      [credentials.py]
      [local_context.py]
      [control.py]
    }

    package "command" {
      [command_builder.py]
      [command_executor.py]
      [command_schema.py]
    }

    package "decision" {
      [policies.py]
      [scripted_sequences.py]
    }

    package "execution" {
      [execute.py]
    }

    package "kb" {
      [kb_schema.py]
      [kb_updater.py]
    }

    package "logging" {
      [logger.py]
    }

    package "parser" {
      [event_builder.py]
      [parser_catalog.py]
      [parser_mapping.py]
      [recon_parser.py]
      [enumeration_parser.py]
      [vulnerability_parser.py]
      [exploitation_parser.py]
      [post_exploitation_parser.py]
      [credential_parser.py]
      [local_context_parser.py]
      [control_parser.py]
      [common.py]
    }

    package "state" {
      [state_builder.py]
      [state_schema.py]
      [state_vectorizer.py]
    }
  }

  package "training" {
    [training_wizard.py]
    [training_services.py]
    [training_logic.py]
    [training_storage.py]
    [vectorization.py]
  }

  package "models" {
    [model_loader.py]
  }

  package "report" {
    [report_wizard.py]
    [report_services.py]
    [report_logic.py]
    [report_generator.py]
    [report_llm_writer.py]
    [report_schema.py]
    [report_storage.py]
  }

  package "settings" {
    [flows.py]
    [logic.py]
  }
}

database "workspace/\nconfig, data, models, logs" as workspace

app --> cli
cli --> session : ejecutar sesiones
cli --> training : datasets / modelos
cli --> report : reportes
cli --> settings : configuración

session --> workspace : kb, trazas, eventos,\ntransiciones, reportes
training --> workspace : datasets,\nmodelos, métricas
report --> workspace : informes
settings --> workspace : configuración
common --> workspace : rutas y entorno

session --> models : usar modelo entrenado
training --> models : guardar modelo
report --> session : leer KB final
training --> session : leer transiciones

@enduml
